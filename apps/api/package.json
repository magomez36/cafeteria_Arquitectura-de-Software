{
  "name": "@cafeteria/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json --incremental false",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=lcov --coverageReporters=text",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:migrate": "tsx src/database/migrate.ts",
    "flags:set": "tsx src/ops/set-feature-flag.ts"
  },
  "dependencies": {
    "@cafeteria/contracts": "workspace:*",
    "@cafeteria/feature-flags": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "dotenv": "^16.6.1",
    "glob": "^11.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "amqplib": "^0.10.8",
    "jest": "^29.7.0",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
