{
  "name": "@cafeteria/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "test:coverage": "vitest run --coverage.enabled --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "devDependencies": {
    "@cafeteria/tsconfig": "workspace:*",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.28.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
